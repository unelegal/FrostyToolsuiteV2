<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vControls="using:FrostyEditor.Views.Controls"
        xmlns:vmControls="using:FrostyEditor.ViewModels.Controls"
        xmlns:vmWindows="using:FrostyEditor.ViewModels.Windows"
        xmlns:lang="using:FrostyEditor.Assets.Lang"
        xmlns:markup="using:FrostyEditor.Utilities.MarkupExtensions"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="420"
        x:Class="FrostyEditor.Views.Windows.ProcessSelectorWindow"
        x:DataType="vmWindows:ProcessSelectorViewModel"
        Design.DataContext="{markup:DesignLocator {x:Type vmWindows:ProcessSelectorViewModel}}"
        Title="Select a process"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        Width="400" Height="800"
        WindowStartupLocation="CenterOwner">
  
  <Panel>
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
          BackgroundSource="Digger"
          TintColor="{DynamicResource SystemChromeLowColor}"
          TintOpacity="1"
          MaterialOpacity="0.65" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>
    
    <Grid RowDefinitions="Auto, *, Auto">
      <TextBlock Grid.Row="0" Text="Select a process" Margin="10"/>
      <ListBox x:Name="ProcessList" Grid.Row="1" Margin="10 2" CornerRadius="5" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Text="{Binding Pid}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5" Margin="10">
        <Button Content="Select" Command="{Binding SelectProcessCommand}"/>
        <Button Content="Cancel" Command="{Binding CloseWindowCommand}"/>
      </StackPanel>
    </Grid>
  </Panel>
  
</Window>
